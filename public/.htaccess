# STUNNING BIRDS ATELIER - Apache & Hostinger Production Configuration
# Ensures correct Single Page Application (SPA) routing, CORS headers, and API handling

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Security & CORS Headers for Razorpay and API communication
  <IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin"
    Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  </IfModule>

  # 2. Respond immediately to OPTIONS preflight requests
  RewriteCond %{REQUEST_METHOD} OPTIONS
  RewriteRule ^(.*)$ $1 [R=204,L]

  # 3. Serve existing static files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. SPA Fallback: Route frontend page navigations to index.html, excluding API routes
  RewriteCond %{REQUEST_URI} !^/api [NC]
  RewriteCond %{REQUEST_URI} !^/payments [NC]
  RewriteRule ^ index.html [L]
</IfModule>

# MIME type handling
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>
